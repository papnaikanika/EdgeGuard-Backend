function generateDemoReading(deviceId) {

    if (!DEMO_MODE) {
        return;
    }

    const device = sensorData[`device${deviceId}`];

    // Normal demonstration values
    const demoValues = {
        1: { current: 10, voltage: 230 },
        2: { current: 14, voltage: 230 },
        3: { current: 18, voltage: 230 }
    };

    const reading = demoValues[deviceId];

    device.current = reading.current;
    device.voltage = reading.voltage;

    saveReading(deviceId);
}


// Generate demo readings every 10 seconds
if (DEMO_MODE) {

    setInterval(() => {

        for (let deviceId = 1; deviceId <= 3; deviceId++) {
            generateDemoReading(deviceId);
        }

    }, 10000);

}

// =================================================
//                    ML PREDICTION
// =================================================

function predictRisk(current) {

    if (current === null || current === undefined) {

        return {
            status: "NORMAL",
            risk: "LOW"
        };
    }

    if (current > 3500) {

        return {
            status: "ANOMALY",
            risk: "HIGH"
        };

    }

    if (current > 3200) {

        return {
            status: "WARNING",
            risk: "MEDIUM"
        };

    }

    return {
        status: "NORMAL",
        risk: "LOW"
    };
}


// =================================================
//              DATABASE INSERT
// =================================================

const insertReading = db.prepare(`
    INSERT INTO sensor_readings
    (device_id, current, voltage, power, status, risk)
    VALUES (?, ?, ?, ?, ?, ?)
`);
// =================================================
//                  ALERT DATABASE
// =================================================

const insertAlert = db.prepare(`
    INSERT INTO alerts
    (device_id, severity, message)
    VALUES (?, ?, ?)
`);

const insertAuditLog = db.prepare(`
    INSERT INTO audit_logs
    (user_id, action, details)
    VALUES (?, ?, ?)
c`);

function createAlert(deviceId, status, risk, current) {

    if (status === "NORMAL") {
        return;
    }

    let severity;
    let message;

    if (status === "WARNING") {

        severity = "MEDIUM";

        message =
            `Unusual current detected: ${current}`;

    }

    else if (status === "ANOMALY") {

        severity = "HIGH";

        message =
            `Abnormal current detected: ${current}`;

    }

    insertAlert.run(
        deviceId,
        severity,
        message
    );

    console.log("");
    console.log("========== ALERT CREATED ==========");
    console.log("Device   :", deviceId);
    console.log("Severity :", severity);
    console.log("Message  :", message);
    console.log("===================================");
}

// =================================================
//                  SAVE READING
// =================================================
function saveReading(deviceId) {

    const device = sensorData[`device${deviceId}`];

    if (
        device.current === null ||
        device.voltage === null
    ) {
        return;
    }

    // Prevent duplicate database entries
    if (
        device.lastSavedCurrent === device.current &&
        device.lastSavedVoltage === device.voltage
    ) {
        return;
    }

const prediction = predictRisk(device.current);

device.status = prediction.status;
device.risk = prediction.risk;
const power =
    device.current * device.voltage;

device.power = power;

insertReading.run(
    deviceId,
    device.current,
    device.voltage,
    power,
    prediction.status,
    prediction.risk
);
    device.lastSavedCurrent = device.current;
    device.lastSavedVoltage = device.voltage;
    createAlert(
    deviceId,
    prediction.status,
    prediction.risk,
    device.current
);
    console.log("");
    console.log("========== READING SAVED ==========");
    console.log("Device  :", deviceId);
    console.log("Current :", device.current);
console.log("Voltage :", device.voltage);
console.log("Power   :", power);
console.log("Status  :", prediction.status);
    console.log("Risk    :", prediction.risk);
    console.log("===================================");
}
// =================================================
//                  MQTT MESSAGE
// =================================================

mqttClient.on("message", (topic, message) => {

    const value = Number(message.toString());

    if (!Number.isFinite(value)) {

        console.log(
            "Invalid MQTT value received:",
            message.toString()
        );

        return;
    }
    if (value < 0) {

    console.log(
        "Invalid negative MQTT value received:",
        value
    );

    return;
}
    console.log("");
    console.log("========== MQTT MESSAGE ==========");
    console.log("Topic :", topic);
    console.log("Value :", value);


    // =============================================
    // DEVICE 1
    // =============================================

    if (topic === "prototype/device1/current") {

        sensorData.device1.current = value;

        saveReading(1);

    }

    else if (topic === "prototype/device1/voltage") {

        sensorData.device1.voltage = value;

        saveReading(1);

    }


    // =============================================
    // DEVICE 2
    // =============================================

    else if (topic === "prototype/device2/current") {

        sensorData.device2.current = value;

        saveReading(2);

    }

    else if (topic === "prototype/device2/voltage") {

        sensorData.device2.voltage = value;

        saveReading(2);

    }


    // =============================================
    // DEVICE 3
    // =============================================

    else if (topic === "prototype/device3/current") {

        sensorData.device3.current = value;

        saveReading(3);

    }

    else if (topic === "prototype/device3/voltage") {

        sensorData.device3.voltage = value;

        saveReading(3);

    }


    console.log("--------------------------------------");

    console.log(
        "Device 1:",
        sensorData.device1
    );

    console.log(
        "Device 2:",
        sensorData.device2
    );

    console.log(
        "Device 3:",
        sensorData.device3
    );

    console.log("======================================");
});


